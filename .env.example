# News Aggregator Environment Variables
# Copy this file to .env and fill in your actual API keys

# News API Keys
NEWS_API_KEY=your_newsapi_key_here
GUARDIAN_API_KEY=your_guardian_api_key_here
NYT_API_KEY=your_nytimes_api_key_here

# AI/OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-3.5-turbo

# Database (if using MongoDB for custom sources)
MONGODB_URI=mongodb://localhost:27017/news-aggregator

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,https://yourdomain.com

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Security
JWT_SECRET=your_jwt_secret_for_user_sessions
BCRYPT_ROUNDS=10

# External Services
WEBHOOK_SECRET=your_webhook_secret
LOG_LEVEL=info

# Custom Sources Configuration
MAX_CUSTOM_SOURCES=50
RSS_FETCH_INTERVAL=300000

# AI Features
MAX_SUMMARY_LENGTH=150
AI_TEMPERATURE=0.3
ENABLE_AI_CHAT=true
ENABLE_AI_SUMMARIES=true