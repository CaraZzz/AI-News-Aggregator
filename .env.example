# News Aggregator Environment Configuration

# NewsAPI Configuration (Optional but recommended)
# Get your free API key from: https://newsapi.org/
# Without this key, the app will fall back to RSS feeds only
NEXT_PUBLIC_NEWS_API_KEY=your_newsapi_key_here

# OpenAI Configuration (Optional for AI features)
# Get your API key from: https://platform.openai.com/
# Without this key, AI summaries and chatbot will be disabled
NEXT_PUBLIC_OPENAI_API_KEY=your_openai_api_key_here

# CORS Proxy Configuration (Advanced users only)
# If you want to use your own CORS proxy instead of the public one
# NEXT_PUBLIC_CORS_PROXY_URL=https://your-cors-proxy.com/

# Custom Configuration
# Enable debug logging (development only)
# NEXT_PUBLIC_DEBUG=true